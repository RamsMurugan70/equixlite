# Copy to .env and fill in. Never commit .env.
#
# In production the app REFUSES to start on an unsafe combination of these rather than starting
# and being quietly insecure. See server/src/config/env.js.

# ── Basics ───────────────────────────────────────────────────────────────────
# PORT: avoid 5060 and 5061 — Chrome refuses them outright with ERR_UNSAFE_PORT because they are
# the SIP ports. The full blocked list is in Chromium's net/base/port_util.cc; 6000, 6665-6669
# and 10080 are other easy ones to trip over.
PORT=5070
NODE_ENV=development
DB_PATH=data/equixlite.db

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs session cookies. Any long random string; changing it logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts stored broker API secrets. 64 hex characters.
# Kept OUT of the database on purpose: a stolen equixlite.db is then not enough to decrypt
# anyone's broker credentials.
#
# KEEP A COPY SOMEWHERE SAFE. Lose it and every stored broker key becomes unreadable — the app
# will tell each user their key cannot be decrypted and ask them to enter it again. Restoring an
# old database with a new key has the same effect.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_KEY=

# ── Deployment ───────────────────────────────────────────────────────────────
# The address users actually reach this on, with scheme, no trailing slash. Two things depend
# on it: the redirect URL shown to users for their Kite Connect app, and the production check
# that refuses to boot on a plain-http URL.
#   dev:  http://localhost:5070
#   prod: https://equixlite.example.com
PUBLIC_URL=http://localhost:5070

# Marks the session cookie Secure. MUST be true in production — the app exits if it is not.
# Leave false in development: a Secure cookie sent over plain http is silently dropped by the
# browser, which presents as "login does nothing".
COOKIE_SECURE=false

# Runs the NIFTY 500 scan at 18:00 IST on weekdays, then sweeps sessions, purges the market
# cache and takes a backup. Defaults to on in production, off otherwise — so a developer does
# not fire five hundred Yahoo requests at six in the evening without having asked for it.
SCHEDULER=false

# ── Ask the Data (optional) ──────────────────────────────────────────────────
# Turns a plain-English question into a read-only SQL query over the caller's own trades and
# holdings only (see server/src/services/askData/askDataService.js for how that's enforced).
# Leave everything below unset and the feature just reports itself as not configured — nothing
# else depends on it.
#
# 'gemini' (default, cloud) or 'ollama' (local model, no data leaves the box).
ASK_LLM_PROVIDER=gemini

# Required for the gemini provider. Rows matched by a question are sent to Gemini for both the
# SQL generation and the plain-English summary — turn ASK_SUMMARIZE=false off below if that
# should not happen for this deployment's users.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Only used for the ollama provider — a model already pulled and running locally (ollama serve).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Whether the result rows get a second LLM call for a plain-English summary, or just a row count.
# Defaults to on for gemini, off for ollama (a second CPU inference roughly doubles the wait).
# ASK_SUMMARIZE=true

# ── docker compose only ──────────────────────────────────────────────────────
# Caddy needs the bare hostname for its certificate; PUBLIC_URL carries the scheme.
# DOMAIN=equixlite.example.com
# ACME_EMAIL=you@example.com
